ngx_addon_name=ngx_http_proxy_filter_test_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_incs="$ngx_addon_dir/.."
    ngx_module_srcs="$ngx_addon_dir/ngx_http_proxy_filter_test_module.c"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    CORE_INCS="$CORE_INCS $ngx_addon_dir/.."
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_proxy_filter_test_module.c"
fi
